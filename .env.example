APP_NAME=EJAM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Riga

# Profile photos and game photos. The production image sets these under /data so the Railway volume keeps them.
# AVATAR_ROOT=/data/avatars
# PHOTO_ROOT=/data/photos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Local file log. Production leaves this unset, or sets LOG_CHANNEL=stderr,
# so logs reach Railway. The container image and entrypoint do that.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry. Leave the DSN empty to disable error reporting: no client sends, no boot failure.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_SEND_DEFAULT_PII=false

DB_CONNECTION=sqlite
# DB_DATABASE=/data/database.sqlite
# Railway Postgres sets DATABASE_URL. When that variable is present and
# DB_CONNECTION is unset, the app uses Postgres automatically.
# DATABASE_URL=postgres://user:password@host:5432/railway

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Resend sends password emails. With no API key the app uses the log mailer instead.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=EJAM

# Shown on the privacy and terms pages. Replace this before you share the app.
CONTACT_EMAIL=hello@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
